{
  "name": "crypto-market-data-mcp",
  "version": "1.0.0",
  "description": "MCP server for real-time crypto prices, OHLCV, DeFi TVL from CoinGecko and DeFiLlama",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "crypto-market-data-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "crypto",
    "market-data",
    "coingecko",
    "defillama",
    "prices",
    "defi",
    "tvl"
  ],
  "author": "nich <nirholas@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "overrides": {
    "hono@^4": "^4.13.7",
    "@hono/node-server@^1": "^2.1.3",
    "ajv@^8": "^8.18.0",
    "@hono/node-server@>=1.19.10 <2.1.3": "^2.1.3"
  }
}
